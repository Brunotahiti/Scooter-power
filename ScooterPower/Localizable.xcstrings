    "Copiez d'abord le message ou le lien reçu de l'autre pilote, puis touchez « Coller une carte ».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First copy the message or link you received from the other rider, then tap \"Paste a card\"."
