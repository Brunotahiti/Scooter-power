      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        }
      }
    },
    "Astuce : choisissez un pseudo dans les réglages pour que l'autre pilote vous reconnaisse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: choose a nickname in Settings so the other rider recognises you."
          }
        }
      }
    },
