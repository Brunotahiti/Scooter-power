        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcis > Automatisation > Bluetooth : choisissez votre casque, puis l'action « Démarrer un trajet ». À la déconnexion : « Terminer le trajet »."
          }
        }
      }
