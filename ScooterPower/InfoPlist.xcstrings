{
  "sourceLanguage": "fr",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power uses the camera to take photos during a trip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power utilise l'appareil photo pour prendre des photos pendant le trajet."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power uses your location to measure speed and distance and to record your route."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power utilise votre position pour mesurer la vitesse, la distance et tracer votre trajet."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power uses motion sensors to measure acceleration and lean angle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power utilise les capteurs de mouvement pour mesurer l'accélération et l'inclinaison."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power saves your trip photos to your photo library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scooter Power enregistre vos photos de trajet dans votre photothèque."
          }
        }
      }
    }
  },
  "version": "1.0"
}
